# Variables de producción: copia este archivo a /home/deploy/app/.env en el VPS.
# Permisos: chmod 600 .env (contiene la clave privada del Worker).

# Imagen en GitHub Container Registry (siempre en minúsculas: ghcr.io/<usuario>/<repo>).
APP_IMAGE=ghcr.io/dartrix137/web-anchetasco

# No pongas APP_TAG aquí: los despliegues usan "latest". Para volver a una
# versión anterior se pasa en la línea de comandos (ver DEPLOY.md).

# Atribución de cotizaciones: Cloudflare Worker + D1 (src/app/api/quote-attribution/route.ts).
# Solo las usa el servidor; nunca llegan al navegador. Si faltan, la web funciona igual
# pero no se registra la atribución.
ATTRIBUTION_WORKER_URL=https://<tu-worker>.workers.dev/<ruta>
ATTRIBUTION_WORKER_SECRET=<clave-privada-configurada-en-cloudflare>
