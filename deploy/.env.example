# Variables de producción: copia este archivo a /home/deploy/app/.env en el VPS.
# La app no necesita claves ni secretos: no hay base de datos ni servicios externos.

# Imagen en GitHub Container Registry (siempre en minúsculas: ghcr.io/<usuario>/<repo>).
APP_IMAGE=ghcr.io/dartrix137/web-anchetasco

# No pongas APP_TAG aquí: los despliegues usan "latest". Para volver a una
# versión anterior se pasa en la línea de comandos (ver DEPLOY.md).
