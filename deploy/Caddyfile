# Caddyfile de producción: /home/deploy/app/Caddyfile
# Se copia desde el repo (deploy/Caddyfile) en cada despliegue: edítalo aquí,
# no en el servidor. Tras el despliegue, GitHub Actions recarga Caddy.
{
	# Correo para avisos de Let's Encrypt (opcional). No lo pongas si el repo es
	# público y no quieres que el correo quede visible en GitHub.
	# email tu-correo@ejemplo.com
}

# Opciones comunes a todos los sitios
(comun) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}

	reverse_proxy app:3000
}

# Sitio principal. Caddy obtiene y renueva el certificado HTTPS de Let's Encrypt
# solo (requiere que el registro DNS A apunte a 50.6.206.188) y redirige
# http://anchetasco.com -> https://anchetasco.com.
anchetasco.com {
	import comun
	header Strict-Transport-Security "max-age=31536000"
}

# www -> dominio sin www (también con certificado propio)
www.anchetasco.com {
	redir https://anchetasco.com{uri} permanent
}

# Acceso por IP (http://50.6.206.188) -> redirige al dominio
:80 {
	redir https://anchetasco.com{uri} permanent
}
